# AgroDirect Production & Development Environment Configuration
# Single Source of Truth for Integrations and Secrets

# Server Configuration
PORT=3000
NODE_ENV=development

# Admin Authorization & Security (Server-Side Provisioning)
# Configured authorized admin Google account & email
ADMIN_EMAIL=<configured-admin-email>
ADMIN_GOOGLE_ACCOUNT=<configured-admin-google-account>
ADMIN_SECRET_KEY=

# Gemini AI API Key (Server-Side Only - Used for Agrobot & Agronomic Intelligence)
GEMINI_API_KEY=

# Firebase Client Configuration (Web SDK)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=agrodirect-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agrodirect-prod
VITE_FIREBASE_STORAGE_BUCKET=agrodirect-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Admin SDK (Server-Side Service Account Credentials)
FIREBASE_ADMIN_PROJECT_ID=agrodirect-prod
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@agrodirect-prod.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# Transactional Email Provider (Resend / SendGrid / Postmark)
EMAIL_SERVICE_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=notifications@agrodirect.in

# Payment Gateway (Razorpay / Stripe / Escrow Partner)
PAYMENT_GATEWAY_PROVIDER=razorpay
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# Agricultural Reference APIs (Govt Agmarknet / IMD Weather)
AGMARKNET_API_KEY=
IMD_WEATHER_API_KEY=
